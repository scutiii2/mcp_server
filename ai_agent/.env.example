# ai_agent's one credentials file. Copy to .env and fill in real values
# (the loaders also create .env from this file on first run). .env itself
# is gitignored - never commit real API keys. Every agent the supervisor
# starts reads the same .env.

# Which LLM an instance is pinned to. One of: anthropic, openai.
# Under the supervisor (run.bat) each agents/<id>.json sets this from its
# llm.provider, so this value only applies to an instance started without
# an agent file (python -m src.server), and only when the AI_AGENT_PROVIDER
# env var isn't set.
AI_AGENT_PROVIDER=anthropic

# Optional - blank uses that provider's own default model, read from its
# gateway block's "model" field in configs/config_gateways.json (see
# src/llm/anthropic_provider.py / openai_provider.py's DEFAULT_MODEL).
# An agent file's llm.model replaces it.
AI_AGENT_MODEL=

# Optional - which persona (system-prompt instructions) an instance started
# without an agent file uses. Blank/unset falls back to
# configs/prompts.json's "default_role". Must name an id present in that
# file's "roles" map - see src/llm/agent_roles.py. The --role CLI flag
# (python -m src.server --role ...) takes precedence over this value, as
# --gateway does over AI_AGENT_GATEWAY below. Agents started by the
# supervisor take their persona from their agent file instead.
AI_AGENT_ROLE=

# Keys for both providers can be set here at once - each provider module
# only ever checks its own gateway's key, so this one .env backs every
# agent, whichever provider its agent file names.
CLAUDE_API_KEY=

# AI_AGENT_GATEWAY picks which block of configs/config_gateways.json's
# provider section (anthropic or openai, matching AI_AGENT_PROVIDER)
# src/llm/anthropic_provider.py or openai_provider.py builds its client
# from - same var, shared across both providers since only one provider
# is active per instance. Default "claude" points at CLAUDE_API_KEY above
# (no base_url - the SDK already defaults to api.anthropic.com; Anthropic's
# own API needs no separate auth_token). Any other value (e.g.
# "openrouter", "bedrock", "vertex", "litellm", "helicone", "portkey")
# names a different block - that file only ever holds "{ENV_VAR_NAME}"
# pointers, never a real secret; put the actual value here under the name
# it points at. Startup only requires a key for whichever gateway is
# actually selected - the others can stay blank. An agent file's
# llm.gateway (or, when omitted, its provider's default) replaces this
# value for that agent.
AI_AGENT_GATEWAY=claude

# configs/config_gateways.json anthropic.openrouter points here
OPENROUTER_AUTH_TOKEN=
OPENROUTER_API_KEY=

# configs/config_gateways.json anthropic.bedrock points here
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# configs/config_gateways.json anthropic.vertex points here
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# configs/config_gateways.json anthropic.litellm points here (self-hosted
# LiteLLM proxy in Anthropic-passthrough mode)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# configs/config_gateways.json anthropic.portkey points here
PORTKEY_API_KEY=

# anthropic.helicone reuses CLAUDE_API_KEY above - no separate var

# configs/config_gateways.json anthropic.omniroute points here (self-hosted
# OmniRoute gateway - npm install -g omniroute; `omniroute` starts it on
# this URL). Its /v1/messages endpoint speaks real Anthropic Messages API
# wire format, but rejects a bare model name as ambiguous - model must
# carry a provider/model prefix (e.g. "anthropic/claude-sonnet-5", already
# set in config_gateways.json). The real upstream Anthropic credentials live
# inside OmniRoute's own dashboard/config, not here - OMNIROUTE_API_KEY is
# only this gateway's own client-auth key.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=

GPT_API_KEY=

# AI_AGENT_GATEWAY (see above) also covers the openai section when
# AI_AGENT_PROVIDER=openai. Default "gpt" points at GPT_API_KEY above (no
# base_url - the SDK already defaults to api.openai.com). "azure" needs
# the AZURE_OPENAI_* vars below (different client class). Any other
# value (e.g. "together", "groq", "fireworks", "deepinfra", "perplexity",
# "ollama", "vllm") names a plain base_url swap block. For agents started
# by the supervisor, each agent file's llm.gateway picks the block; the
# AI_AGENT_GATEWAY value above only matters for an instance started without
# an agent file, and must match that instance's provider.

# configs/config_gateways.json openai.azure points here
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
PERPLEXITY_API_KEY=

# ollama/vllm are typically self-hosted - base_url points at your own
# server; api_key is often unchecked by these servers but the OpenAI SDK
# still requires a non-empty string, so put any placeholder value.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# ---- Internal API auth (was secrets/secret_internal_api.env) ----
# Set the same value as mcp_server's INTERNAL_API_TOKEN (mcp_server/.env)
# and ember_api's (ember_api/secrets/secret_internal_api.env). Generate
# one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# When set, this agent's /mcp rejects requests without it
# (X-Internal-Token), and the agent sends it on its own calls to
# mcp_server and to peer agents. Leave blank only while every caller stays
# on this machine.
INTERNAL_API_TOKEN=
