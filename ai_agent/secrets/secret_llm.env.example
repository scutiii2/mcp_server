# Copy to secret_llm.env and fill in real values. secret_llm.env itself
# is gitignored - never commit real API keys.

# Which LLM this ai_agent instance is pinned to. One of: anthropic, openai.
# Overridable per-process via the AI_AGENT_PROVIDER env var (see
# ai_agent/run.bat) - this file's value is only the fallback when that
# env var isn't set.
AI_AGENT_PROVIDER=anthropic

# Optional - blank uses that provider's own default model, read from its
# gateway block's "model" field in configs/config_llms.json (see
# src/llm/anthropic_provider.py / openai_provider.py's DEFAULT_MODEL).
AI_AGENT_MODEL=

# Optional - which AI agent persona (system-prompt instructions) this
# instance uses. Blank/unset falls back to configs/config_ai_agent_roles.json's
# "default_role". Must name an id present in that file's "roles" map - see
# src/llm/agent_roles.py. Overridable per-process via the --role CLI flag
# (`run.bat --role ...`), which takes precedence over this file's value,
# same relationship as AI_AGENT_GATEWAY above has with --gateway.
AI_AGENT_ROLE=

# Both keys can be set here at once - each provider module only ever
# checks its own gateway's key, so one secret_llm.env backs both the
# claude-agent and openai-agent instances (two `run.bat` runs with
# different AI_AGENT_PROVIDER/AI_AGENT_PORT overrides).
CLAUDE_API_KEY=

# AI_AGENT_GATEWAY picks which block of configs/config_llms.json's
# provider section (anthropic or openai, matching AI_AGENT_PROVIDER)
# src/llm/anthropic_provider.py or openai_provider.py builds its client
# from - same var, shared across both providers since only one provider
# is active per instance. Default "claude" points at CLAUDE_API_KEY above
# (no base_url - the SDK already defaults to api.anthropic.com; Anthropic's
# own API needs no separate auth_token). Any other value (e.g.
# "openrouter", "bedrock", "vertex", "litellm", "helicone", "portkey")
# names a different block - that file only ever holds "{ENV_VAR_NAME}"
# pointers, never a real secret; put the actual value here under the name
# it points at. Startup only requires a key for whichever gateway is
# actually selected - the others can stay blank.
AI_AGENT_GATEWAY=claude

# configs/config_llms.json anthropic.openrouter points here
OPENROUTER_AUTH_TOKEN=
OPENROUTER_API_KEY=

# configs/config_llms.json anthropic.bedrock points here
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# configs/config_llms.json anthropic.vertex points here
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# configs/config_llms.json anthropic.litellm points here (self-hosted
# LiteLLM proxy in Anthropic-passthrough mode)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# configs/config_llms.json anthropic.portkey points here
PORTKEY_API_KEY=

# anthropic.helicone reuses CLAUDE_API_KEY above - no separate var

# configs/config_llms.json anthropic.omniroute points here (self-hosted
# OmniRoute gateway - npm install -g omniroute; `omniroute` starts it on
# this URL). Its /v1/messages endpoint speaks real Anthropic Messages API
# wire format, but rejects a bare model name as ambiguous - model must
# carry a provider/model prefix (e.g. "anthropic/claude-sonnet-5", already
# set in config_llms.json). The real upstream Anthropic credentials live
# inside OmniRoute's own dashboard/config, not here - OMNIROUTE_API_KEY is
# only this gateway's own client-auth key.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=

GPT_API_KEY=

# AI_AGENT_GATEWAY (see above) also covers the openai section when
# AI_AGENT_PROVIDER=openai. Default "gpt" points at GPT_API_KEY above (no
# base_url - the SDK already defaults to api.openai.com). "azure" needs
# the AZURE_OPENAI_* vars below (different client class). Any other
# value (e.g. "together", "groq", "fireworks", "deepinfra", "perplexity",
# "ollama", "vllm") names a plain base_url swap block. Leave this at
# "claude" above when running the anthropic instance, or set it to
# "gpt"/etc when running the openai instance - whichever value applies to
# AI_AGENT_PROVIDER for that process.

# configs/config_llms.json openai.azure points here
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
PERPLEXITY_API_KEY=

# ollama/vllm are typically self-hosted - base_url points at your own
# server; api_key is often unchecked by these servers but the OpenAI SDK
# still requires a non-empty string, so put any placeholder value.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
