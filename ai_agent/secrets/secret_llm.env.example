# Copy to secret_llm.env and fill in real values. secret_llm.env itself
# is gitignored - never commit real API keys.

# Which LLM this ai_agent instance is pinned to. One of: claude, openai.
# Overridable per-process via the AI_AGENT_PROVIDER env var (see
# run_ai_agent_claude.bat / run_ai_agent_openai.bat) - this file's value
# is only the fallback when that env var isn't set.
AI_AGENT_PROVIDER=claude

# Optional - blank uses that provider's own default model (see
# src/llm/claude_provider.py / openai_provider.py's DEFAULT_MODEL).
AI_AGENT_MODEL=

# Both keys can be set here at once - each provider module only ever
# checks its own key, so one secret_llm.env backs both the claude-agent
# and openai-agent instances (run_ai_agent_claude.bat / _openai.bat).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
