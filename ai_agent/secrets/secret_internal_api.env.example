# Copy to secret_internal_api.env (done automatically on first run) and set
# the same value as mcp_server's, chat_app's and ember_api's
# secret_internal_api.env. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# When set, this agent's /mcp rejects requests without it
# (X-Internal-Token), and the agent sends it on its own calls to
# mcp_server and to peer agents. Leave blank only while every caller stays
# on this machine.
INTERNAL_API_TOKEN=
