# Used by src/services/email_service.py for auto-emailed invite OTPs (added in a later phase).
#
# SMTP_HOST/SMTP_PORT depend on which provider MAIL_FROM_ADDRESS lives on:
#   Gmail                    smtp.gmail.com        587  (app password required, 2FA)
#   Outlook / Hotmail / Live smtp.office365.com    587  (app password required, 2FA)
#   Proton Mail               127.0.0.1             1025 (needs Proton Mail Bridge running
#                                                          locally - Proton has no direct SMTP;
#                                                          use the Bridge's generated password,
#                                                          not the mailbox password, and the
#                                                          host/port from Bridge's settings pane)
# All three want SMTP_USE_TLS=true (STARTTLS on these ports).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=
