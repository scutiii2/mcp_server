# Copy to .env in this same directory (chat_app/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Required for the OpenAI provider - omit to leave it grayed out in the
# provider dropdown rather than failing when selected.
OPENAI_API_KEY=sk-...

# Required for the Claude provider - same grayed-out behavior when unset.
ANTHROPIC_API_KEY=sk-ant-...

# Authentication. Both must be set to enable it. While unset, the app
# runs but serves LOOPBACK REQUESTS ONLY - convenient locally, and it
# means exposing this to a network is a deliberate act rather than
# something you drift into.
#
# Set these before putting the app behind a reverse proxy: the
# loopback fallback goes by the connecting address, and a proxy makes
# every request look local.
CHAT_AUTH_USER=
CHAT_AUTH_PASSWORD=

# Per-user login. REQUIRED - unlike CHAT_AUTH_USER/CHAT_AUTH_PASSWORD
# above, this has no "leave blank to skip" option: every route redirects
# to /login until someone signs in (session cookie, via FLASK_SECRET_KEY
# below), unconditionally. ADMIN_USERNAME/ADMIN_PASSWORD is the one
# account that always exists - log in as it to generate invite codes,
# which is the only way anyone else can register (see /register).
# chat_app.run refuses to start if both are blank and users.db has no
# accounts yet, since that combination would boot a server nobody could
# ever log into. This is a separate, inner gate from
# CHAT_AUTH_USER/CHAT_AUTH_PASSWORD, which is the outer one deciding
# whether the app is reachable from the network at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Where runtime-created accounts and invite codes are stored. Relative to
# CWD by default, same convention as CHAT_CONFIG_PATH below.
USERS_DB_PATH=data/users.db

# Comma-separated hostnames this app may be reached under, beyond
# localhost/127.0.0.1 which are always allowed. A request whose Host
# header isn't in this list is refused - that's what stops DNS rebinding,
# where an attacker's domain re-resolves to 127.0.0.1 so their page can
# talk to your local app.
CHAT_ALLOWED_HOSTS=

# Optional - defaults shown. OPENAI_MODEL/CLAUDE_MODEL must be one of the
# ids in that provider's MODELS list (top of its provider file), since
# those are what the model dropdown offers.
MCP_SERVER_URL=http://127.0.0.1:8010/mcp
OPENAI_MODEL=gpt-5.6-sol
CLAUDE_MODEL=claude-sonnet-5
# Leave unset and a random key is generated at startup - safe, but
# sessions won't survive a restart. Set it to a real random value
# (python -c "import secrets; print(secrets.token_urlsafe(32))") if that
# matters. The old placeholder "dev-change-me" is rejected: a default
# everyone can read is the same as no secret at all.
FLASK_SECRET_KEY=
FLASK_HOST=127.0.0.1
FLASK_PORT=5009

# Optional - local Ollama provider, manual-select only (not part of
# Automatic - see ollama_provider.py's module docstring for why). No API
# key needed. Point OLLAMA_BASE_URL at your Ollama host's LAN address,
# NOT localhost, if it's running on a different machine than chat_app -
# and make sure Ollama itself is configured to accept non-localhost
# connections (OLLAMA_HOST=0.0.0.0 on the Ollama side), since it binds to
# 127.0.0.1 only by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# The model list itself is no longer an env var - it lives in
# config.json (path configurable via CHAT_CONFIG_PATH, default
# "config.json"), under "providers.ollama.models". Copy config.json.example
# to config.json and list whatever you want offered; the app checks live
# (via Ollama's /api/tags) which of those are actually pulled and greys
# out the rest rather than letting a stale selection fail at chat time.
