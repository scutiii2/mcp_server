# Copy to .env in this same directory (chat_app/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Required for the OpenAI provider - /chat fails on that provider without it.
OPENAI_API_KEY=sk-...

# Required for the Claude provider - omit to leave it grayed out in the
# provider dropdown rather than failing when selected.
ANTHROPIC_API_KEY=sk-ant-...

# Optional - defaults shown.
MCP_SERVER_URL=http://127.0.0.1:8010/mcp
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-5
FLASK_SECRET_KEY=change-me-to-something-random
FLASK_HOST=127.0.0.1
FLASK_PORT=5009

# Optional - local Ollama provider, manual-select only (not part of
# Automatic - see ollama_provider.py's module docstring for why). No API
# key needed. Point OLLAMA_BASE_URL at your Ollama host's LAN address,
# NOT localhost, if it's running on a different machine than chat_app
# (e.g. a ZimaOS box on the same network) - and make sure Ollama itself
# is configured to accept non-localhost connections (OLLAMA_HOST=0.0.0.0
# on the Ollama side), since it binds to 127.0.0.1 only by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Comma-separated "model_id=Label" pairs, matching whatever you've
# actually pulled locally (check with `ollama list`) - uses "=" not ":"
# as the separator since Ollama model IDs already contain a colon
# themselves (the name:tag format, e.g. "qwen2.5:3b").
OLLAMA_MODELS=llama3.2:1b=Llama 3.2 1B (local)