# Copy to .env in this same directory (chat_app/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Required - /chat fails without it. /capabilities works fine without it.
OPENAI_API_KEY=sk-...

# Optional - defaults shown.
MCP_SERVER_URL=http://127.0.0.1:8010/mcp
OPENAI_MODEL=gpt-4o
FLASK_SECRET_KEY=change-me-to-something-random
FLASK_HOST=127.0.0.1
FLASK_PORT=5009
