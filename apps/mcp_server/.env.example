# Copy to .env in this folder and fill in real values (done automatically on
# first run; an old .secrets/ folder is migrated into .env instead). .env is
# gitignored - never commit real values.
#
# Referenced by name from configs/*.json via ${VAR} placeholders, e.g.
# config_email.json's "password": "${SMTP_PASSWORD}".

# ---- Server (optional - defaults shown) ----
# MCP_HOST is loopback on purpose. This server has NO authentication:
# anything that can reach the port can call every registered tool with
# arbitrary arguments, and the Flask app is not in that path, so auth
# there does not protect this. Only set 0.0.0.0 once something in front
# of it (reverse proxy, VPN, firewall) is doing the authenticating.
MCP_HOST=127.0.0.1
MCP_PORT=8010

# ---- Internal API auth ----
# Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The same value as ai_agent's and ember_api's INTERNAL_API_TOKEN. When
# set, every request to /mcp must carry it (X-Internal-Token), and
# POST /upload always does. There's no human login on these calls, so it
# is the entire authorization - treat it like a password.
INTERNAL_API_TOKEN=

# ---- SMTP ----
# Backs "password" in config_email.json. On a mainstream provider
# (Gmail, Outlook, Yahoo, iCloud) this must be an app-specific password,
# not the account password: they all refuse plain SMTP logins on an
# account with 2FA enabled.
#
# If the relay wants no authentication at all - a local or LAN MTA that
# authorizes by source address, usually with "security": "none" in
# config_email.json - drop the "password" key from config_email.json
# entirely and delete this line. Leaving it blank is NOT the way to do
# that: a "${SMTP_PASSWORD}" placeholder resolving to an empty string is
# rejected at load time, because in practice that means someone forgot
# to fill it in rather than meaning "no auth".
SMTP_PASSWORD=

# Backs "teams_webhook_url" in config_email.json, if set - an MS Teams
# incoming webhook URL (Teams channel > Connectors > Incoming Webhook).
# Optional: Watchers only post to Teams when this resolves to
# a non-empty value; leave the "teams_webhook_url" key out of
# config_email.json entirely (not just this line blank) to skip Teams
# alerts altogether.
TEAMS_WEBHOOK_URL=

# ---- SSH ----
# SSH host-key verification. "reject" (default) refuses a host whose key
# isn't in the known_hosts file below - which is mainly how you find out
# a key CHANGED, the signal that actually matters. "auto" trusts the
# first key it sees and records it, so you can enrol a new host that way
# and then switch back to reject.
SSH_HOST_KEY_POLICY=reject
SSH_KNOWN_HOSTS=

# ---- Web Research capability ----
# Tavily API key (https://app.tavily.com). Without it the /web tools report this variable is missing.
TAVILY_API_KEY=

# ---- Web Scraping capability (Firecrawl) ----
# Firecrawl API key (https://www.firecrawl.dev/app). Without it the /scrape tools report this variable is missing.
FIRECRAWL_API_KEY=
# Optional: address of a self-hosted Firecrawl. Blank uses the hosted API. The key is then optional.
FIRECRAWL_API_URL=

# ---- Read-only capability folders (optional - defaults relative to apps/mcp_server/) ----
# MCP_USAGE_DIR=../ai_agent/data/usage
# MCP_VAULT_DIR=../../../../Brain
# MCP_WORKSPACE_DIR=../../../..

# ---- Watchers capability (optional) ----
# Folder for watcher state and recipient lists. Default .data/watchers, relative to apps/mcp_server/.
# MCP_WATCHERS_DIR=
