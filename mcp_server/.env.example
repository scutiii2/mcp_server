# Copy to .env in this same directory (mcp_server/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Path to the JSON config file (see config.json.example). Defaults to
# ./config.json relative to the working directory, which is fragile -
# set an absolute path here.
CONFIG_PATH=/absolute/path/to/config.json

# Secrets referenced from config.json as ${NAME}. Structure lives in that
# file; the actual values live here, so config.json stays free of
# credentials. Every ${NAME} it uses must resolve to a non-empty value in
# the environment or the server fails at startup, naming the variable and
# the config key that wanted it.
#
# In production, prefer having the service manager, container runtime, or
# a secrets manager put these in the environment instead of a file on
# disk - nothing else has to change for that to work.
SMTP_PASSWORD=

# Optional - defaults shown.
MCP_HOST=0.0.0.0
MCP_PORT=8010

# SQLite file backing infra/pending_requests.py, for approval-gated or
# resumable capabilities. Relative to the working directory by default.
PENDING_REQUESTS_PATH=pending_requests.db

# The address an approval email's link should point at. Deliberately not
# derived from MCP_HOST above: 0.0.0.0 is a bind address, not something
# that resolves from someone's inbox. Set this to a real VPN or
# reverse-proxy hostname for any deployment beyond local testing.
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8010
