# Copy to .env in this same directory (mcp_server/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Path to the JSON config file (see config.json.example). Defaults to
# ./config.json relative to the working directory, which is fragile -
# set an absolute path here.
CONFIG_PATH=/absolute/path/to/config.json

# Secrets referenced from config.json as ${NAME}. Structure lives in that
# file; the actual values live here, so config.json stays free of
# credentials. Every ${NAME} it uses must resolve to a non-empty value in
# the environment or the server fails at startup, naming the variable and
# the config key that wanted it.
#
# In production, prefer having the service manager, container runtime, or
# a secrets manager put these in the environment instead of a file on
# disk - nothing else has to change for that to work.
#
# SMTP_PASSWORD backs "email.password" in config.json. On a mainstream
# provider (Gmail, Outlook, Yahoo, iCloud) this must be an app-specific
# password, not the account password: they all refuse plain SMTP logins on
# an account with 2FA enabled.
#
# Which port and TLS mode to use is "email.smtp_port" / "email.security"
# in config.json: 465 with "ssl" (implicit TLS - the usual choice for a
# consumer provider), 587 with "starttls", or "none" for no TLS at all.
# "security" can be left out; port 465 infers "ssl" and any other port
# infers "starttls".
#
# If the relay wants no authentication at all - a local or LAN MTA that
# authorizes by source address, usually with "security": "none" - drop the
# "password" key from config.json entirely and delete this line. Leaving
# it blank is NOT the way to do that: a "${SMTP_PASSWORD}" placeholder
# resolving to an empty string is rejected at load time, because in
# practice that means someone forgot to fill it in rather than meaning
# "no auth".
SMTP_PASSWORD=

# Backs "hosts.desktop.password" in config.json - the SSH password for a
# host configured without a key.
DESKTOP_SSH_PASSWORD=

# Optional - defaults shown.
#
# MCP_HOST is loopback on purpose. This server has NO authentication:
# anything that can reach the port can call every registered tool with
# arbitrary arguments, and the Flask app is not in that path, so auth
# there does not protect this. Only set 0.0.0.0 once something in front
# of it (reverse proxy, VPN, firewall) is doing the authenticating.
MCP_HOST=127.0.0.1
MCP_PORT=8010

# SSH host-key verification. "reject" (default) refuses a host whose key
# isn't in the known_hosts file below - which is mainly how you find out
# a key CHANGED, the signal that actually matters. "auto" trusts the
# first key it sees and records it, so you can enrol a new host that way
# and then switch back to reject.
SSH_HOST_KEY_POLICY=reject
SSH_KNOWN_HOSTS=

# SQLite file backing infra/pending_requests.py, for approval-gated or
# resumable capabilities. Relative to the working directory by default.
PENDING_REQUESTS_PATH=pending_requests.db

# SQLite file backing infra/otp.py - one-time passcode records. Kept in a
# separate file rather than another table so the short-lived churn of
# codes can be deleted wholesale (or put on a tmpfs) without touching
# pending approvals. Only the path is configurable: code length, TTL and
# the attempt limit are constants in infra/otp.py, because those are what
# make a six-digit secret safe and an env var is too easy a place to
# weaken them from.
OTP_PATH=otp.db

# Where server.log (combined app log, rotated at 5MB x3) and per-error
# files (logs/errors/<reference>.log, one per reference id shown on the
# approval-failure page - see errors.py) are written. Relative to the
# working directory by default, same convention as the paths above.
MCP_LOG_DIR=logs

# The address an approval email's link should point at. Deliberately not
# derived from MCP_HOST above: 0.0.0.0 is a bind address, not something
# that resolves from someone's inbox. Set this to a real VPN or
# reverse-proxy hostname for any deployment beyond local testing.
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8010
