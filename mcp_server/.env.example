# Copy to .env in this same directory (mcp_server/) and fill in real values.
# .env is loaded automatically by run.py via python-dotenv.

# Required in practice - defaults to ./config.json relative to cwd if unset.
SAP_CONFIG_PATH=/absolute/path/to/config.json

# Optional - defaults shown.
MCP_HOST=0.0.0.0
MCP_PORT=8010
