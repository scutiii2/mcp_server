{
  "host": "127.0.0.1",
  "port": 8030,
  "database_path": "data/ember_api.db",
  "session_cookie_name": "ember_session",
  "session_hours": 12,
  "cookie_secure": false,
  "default_role": "Member",
  "agents_registry_path": "../ai_agent/configs/config_agents.json",
  "mcp_server_url": "http://127.0.0.1:8010/mcp",
  "security": {
    "trusted_proxies": [
      "127.0.0.1",
      "::1"
    ],
    "rate_limit": {
      "enabled": true,
      "scope": "both",
      "max_attempts": 5,
      "window_seconds": 900,
      "lockout_seconds": 900
    },
    "ip_filter": {
      "allow_list": [],
      "deny_list": []
    },
    "headers": {
      "enabled": true,
      "hsts_max_age": 0
    }
  }
}
