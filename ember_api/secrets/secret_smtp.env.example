# SMTP account ember_api sends invite and email-verification codes from.
# Same keys as chat_app/secrets/secret_smtp.env.
#
#   Gmail                    smtp.gmail.com        587  (app password, 2FA required)
#   Outlook / Hotmail / Live smtp.office365.com    587  (app password, 2FA required)
#   Proton Mail              127.0.0.1             1025 (Proton Mail Bridge running locally)
# All use SMTP_USE_TLS=true (STARTTLS on these ports).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=
