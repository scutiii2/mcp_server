__pycache__/
*.pyc
.venv/
.venv_*/
*.egg-info/
.claude/*
!.claude/skills/
.pytest_cache/
.secret
.vscode

# server_launcher's local settings and runtime state - per-machine, not source.
/apps/server_launcher/.data/

# mcp_server's real config/secrets/runtime-state. config_*.json holds
# structure (committed) with ${VAR} placeholders for anything sensitive;
# .env holds the real values (gitignored) those placeholders resolve to.
# Both keep an .example twin, which IS committed. .secrets/ is the legacy
# folder run.py migrates into .env on first start.
/apps/mcp_server/.env
/apps/mcp_server/.secrets/*
!/apps/mcp_server/.secrets/*.example

# ai_agent's real API keys / pinned-provider selection, same treatment
# as mcp_server's secret_*.env above - only .env.example is committed.
/apps/ai_agent/.env
/apps/ai_agent/configs/*
!/apps/ai_agent/configs/*.example
!/apps/ai_agent/configs/README.md
# ai_agent's real agent definitions (the templates below are committed)
# and its per-agent token usage log.
/apps/ai_agent/agents/*
!/apps/ai_agent/agents/agents.json.template
!/apps/ai_agent/agents/triage-assistant.json.template
/apps/ai_agent/.data/

# mcp_server's real SMTP-account addresses. The equivalent data lived in the old root-level config.json,
# which was gitignored outright - these carry the same real deployment
# details (no literal secrets, those are all ${VAR}) and keep the same
# treatment. config_extensions.json and config_capabilities.json are NOT
# listed here - low-sensitivity structure, tracked normally like their
# .example twins.
/apps/mcp_server/configs/config_email.json

# Runtime state, not source: one-time-code
# records, and any capability's own data/ (e.g. capabilities/otp/data/).
# All hold security-relevant material or are regenerated on every run.
/apps/mcp_server/.data/
/apps/mcp_server/.logs/
/apps/mcp_server/.cache/

# Per-capability state/config under mcp_server/specifics/<capability_name>/:
# dot-prefixed folders are untracked runtime state and secrets; the plain
# configs/ folder next to them is tracked. Includes audit DBs and
# JobWatcher persisted state ({state_dir}/{WatcherClass}/{key}.json).
/apps/mcp_server/specifics/*/.data/
/apps/mcp_server/specifics/*/.logs/
/apps/mcp_server/specifics/*/.cache/
/apps/mcp_server/specifics/*/.secrets/
*.db



# Runtime logs: combined server.log plus one file per error reference id
# (see chat_app/mcp_server's logging_setup.py / errors.py). Regenerated
# on every run, not source. Anchored to each app's own root (not a bare
# "logs/") - unanchored, this also matched chat_app's SOURCE blueprint at
# pages/logs/, silently excluding it from version control entirely.
/apps/chat_app/logs/

zip_versions/

# Local git worktrees used for isolated feature work (superpowers
# subagent-driven-development) - scratch checkouts, not source.
.worktrees/

# Subagent-driven-development scratch, not source.
.superpowers/

MCPServer.yaml
.sessions/
.output/
PyRFC
config_*.json
dev_rfc.log



# Archive snapshots are never tracked
*.zip
